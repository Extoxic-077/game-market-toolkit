{
  "name": "game-market-toolkit",
  "version": "0.1.0",
  "description": "Framework-independent TypeScript utilities for gaming and digital-item marketplaces.",
  "license": "MIT",
  "author": "Extoxic-077",
  "repository": { "type": "git", "url": "https://github.com/Extoxic-077/game-market-toolkit.git" },
  "homepage": "https://github.com/Extoxic-077/game-market-toolkit#readme",
  "bugs": { "url": "https://github.com/Extoxic-077/game-market-toolkit/issues" },
  "keywords": ["gaming-marketplace", "digital-goods", "marketplace", "typescript", "pricing", "orders"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": { "zod": "^4.1.12" },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" }
}
